# Copy to .env (chmod 600). Read by `docker compose` in this folder. Plain KEY=value lines.

# Public host name of the app (Cloudflare DNS record, proxied). The web app is served at /, the
# API at /api and /ws on the same host.
APP_DOMAIN=vhrbo.tech

# Path of the web repository (impostor-game-web), relative to this folder.
WEB_DIR=../../web

POSTGRES_USER=impostor
POSTGRES_DB=impostor
# From the password manager. Letters and digits only (it goes inside DATABASE_URL), 32+ chars.
POSTGRES_PASSWORD=
