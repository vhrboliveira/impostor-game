# Copy to .env and adjust. Plain KEY=value lines only (the Makefile includes this file).

# Application
APP_ENV=dev
PORT=8080
LOG_LEVEL=debug
# Comma-separated origins allowed to open WebSocket connections.
ALLOWED_ORIGINS=http://localhost:5173
ROOM_TTL=24h
EMPTY_ROOM_TTL=1h

# Database (matches docker-compose.yml)
POSTGRES_USER=impostor
POSTGRES_PASSWORD=impostor
POSTGRES_DB=impostor
DATABASE_URL=postgres://impostor:impostor@localhost:5436/impostor?sslmode=disable

# Integration tests. The database name MUST end with _test: the test helper wipes its schema.
TEST_DATABASE_URL=postgres://impostor:impostor@localhost:5436/impostor_test?sslmode=disable
